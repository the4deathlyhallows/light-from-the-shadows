// ============================================================================
// AHK RAT Loader Campaign — Google SecOps (Chronicle) YARA-L 2.0 rules
// Ref: https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns
// Ref: https://thehackernews.com/2021/05/experts-warn-about-ongoing-autohotkey.html
//
// Assumptions / things to verify against your own UDM mapping before enabling:
//   - PROCESS_LAUNCH: principal.process = parent, target.process = child
//     (standard for Sysmon EventID 1 / EDR process-create events ingested via
//     Chronicle's default parsers). Confirm this holds for your log source.
//   - FILE_CREATION / FILE_MODIFICATION: target.file.full_path holds the path.
//   - PowerShell Script Block Logging (Event ID 4104) has no universal default
//     UDM mapping. metadata.product_event_type = "4104" and the field holding
//     ScriptBlockText will vary by parser (commonly target.process.command_line,
//     principal.process.command_line, or security_result.description) — check
//     with `metadata.product_event_type = "4104"` in UDM Search first and patch
//     the field reference in ahk_loader_scriptblock_httpwebrequest_cradle below.
//   - Static/byte-level content scanning (the StrReverse+Chr/Asc/Mid VBS
//     obfuscation pattern) is not natively expressible in YARA-L, since SecOps
//     rules run over UDM log events, not raw file bytes. Use the companion
//     ahk_loader_vbs_obfuscation.yar (classic YARA, for EDR/AV or a file-scan
//     pipeline) for that check. A best-effort UDM approximation is included
//     below in case your EDR forwards script content as a log field.
// ============================================================================

rule ahk_loader_compiled_ahk_spawns_script_host {
  meta:
    author = "Detection Engineering"
    description = "Compiled AutoHotkey executable spawns WScript/CScript/PowerShell — initial stage of the AHK RAT loader campaign (Revenge RAT, LimeRAT, AsyncRAT, Houdini, Vjw0rm)."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Execution"
    mitre_attack_technique = "Command and Scripting Interpreter: Visual Basic"
    mitre_attack_technique_id = "T1059.005"
    severity = "High"
    priority = "High"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    (
      $e.principal.process.file.full_path = /AutoHotkey(U32|U64|A32)?\.exe$/ nocase
      or $e.principal.process.command_line = /AutoHotkey/ nocase
    )
    $e.target.process.file.full_path = /\\(wscript|cscript|powershell|pwsh)\.exe$/ nocase

  outcome:
    $risk_score = max(65)

  condition:
    $e
}

rule ahk_loader_vbs_spawns_hidden_encoded_powershell {
  meta:
    author = "Detection Engineering"
    description = "WScript/CScript spawns PowerShell with hidden-window/encoded-command flags — matches the AHK loader's decode chain (obfuscated VBS -> PowerShell -> payload)."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Execution"
    mitre_attack_technique = "Command and Scripting Interpreter: PowerShell"
    mitre_attack_technique_id = "T1059.001"
    severity = "High"
    priority = "High"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.principal.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $e.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $e.target.process.command_line = /(-enc\b|-EncodedCommand|-e\b|-nop|-noni|-w(indowstyle)? ?hidden|IEX|Invoke-Expression|DownloadString|DownloadData|FromBase64String)/ nocase

  outcome:
    $risk_score = max(75)

  condition:
    $e
}

rule ahk_loader_paste_host_process_download {
  meta:
    author = "Detection Engineering"
    description = "Script interpreter or LOLBIN fetches content from a Pastebin-style raw-text host, matching the campaign's stikked.ch-hosted C# payload stage."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Command and Control"
    mitre_attack_technique = "Ingress Tool Transfer"
    mitre_attack_technique_id = "T1105"
    severity = "Medium"
    priority = "Medium"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.target.process.file.full_path = /\\(powershell|pwsh|wscript|cscript|curl|bitsadmin|certutil)\.exe$/ nocase
    $e.target.process.command_line = /(stikked\.ch|pastebin\.com\/raw|paste\.ee|hastebin\.com|rentry\.co|controlc\.com)/ nocase

  outcome:
    $risk_score = max(60)

  condition:
    $e
}

rule ahk_loader_paste_host_network_dns {
  meta:
    author = "Detection Engineering"
    description = "DNS resolution of a Pastebin-style raw-text host, network-layer companion to ahk_loader_paste_host_process_download for environments with DNS telemetry but incomplete process command-line logging."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Command and Control"
    mitre_attack_technique = "Ingress Tool Transfer"
    mitre_attack_technique_id = "T1105"
    severity = "Low"
    priority = "Low"

  events:
    $e.metadata.event_type = "NETWORK_DNS"
    $e.network.dns.questions.name = /(stikked\.ch|pastebin\.com|paste\.ee|hastebin\.com|rentry\.co|controlc\.com)/ nocase

  outcome:
    $risk_score = max(35)

  condition:
    $e
}

rule ahk_loader_defender_tampering {
  meta:
    author = "Detection Engineering"
    description = "Disables Windows Defender real-time protection or stops WinDefend — matches the AHK loader variant that used a Batch script (triggered via LNK) to blind Defender before dropping the RAT."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Defense Evasion"
    mitre_attack_technique = "Impair Defenses: Disable or Modify Tools"
    mitre_attack_technique_id = "T1562.001"
    severity = "High"
    priority = "High"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    (
      ($e.target.process.command_line = /Set-MpPreference/ nocase and $e.target.process.command_line = /DisableRealtimeMonitoring/ nocase)
      or ($e.target.process.file.full_path = /\\sc\.exe$/ nocase and $e.target.process.command_line = /(stop WinDefend|config WinDefend start= disabled)/ nocase)
      or ($e.target.process.file.full_path = /\\reg\.exe$/ nocase and $e.target.process.command_line = /Windows Defender/ nocase and $e.target.process.command_line = /(DisableAntiSpyware|DisableRealtimeMonitoring|DisableAntiVirus)/ nocase)
      or ($e.target.process.file.full_path = /\\taskkill\.exe$/ nocase and $e.target.process.command_line = /MsMpEng/ nocase)
    )

  outcome:
    $risk_score = max(85)

  condition:
    $e
}

rule ahk_loader_lnk_created_suspicious_path {
  meta:
    author = "Detection Engineering"
    description = "Shortcut (.lnk) file created under AppData/Temp/Startup — low-fidelity alone, pair with ahk_loader_lnk_triggers_batch_script or ahk_loader_defender_tampering for the specific AHK loader variant."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Persistence"
    mitre_attack_technique = "Boot or Logon Autostart Execution: Shortcut Modification"
    mitre_attack_technique_id = "T1547.009"
    severity = "Low"
    priority = "Low"

  events:
    $e.metadata.event_type = "FILE_CREATION"
    $e.target.file.full_path = /\.lnk$/ nocase
    $e.target.file.full_path = /\\(AppData|Temp|Startup)\\/ nocase

  outcome:
    $risk_score = max(25)

  condition:
    $e
}

rule ahk_loader_lnk_triggers_batch_script {
  meta:
    author = "Detection Engineering"
    description = "Multi-event correlation: an .lnk is dropped on a host, then a Batch/CMD script is launched on the same host within 10 minutes — matches the AHK loader variant that used an LNK to trigger a Defender-disabling Batch script. Host-level correlation, not direct parent/child, since LNK execution is mediated by explorer.exe."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Persistence"
    mitre_attack_technique = "Boot or Logon Autostart Execution: Shortcut Modification"
    mitre_attack_technique_id = "T1547.009"
    severity = "High"
    priority = "High"

  events:
    $lnk.metadata.event_type = "FILE_CREATION"
    $lnk.target.file.full_path = /\.lnk$/ nocase
    $lnk.target.file.full_path = /\\(AppData|Temp|Startup)\\/ nocase
    $lnk.principal.hostname = $hostname

    $bat.metadata.event_type = "PROCESS_LAUNCH"
    $bat.principal.hostname = $hostname
    ($bat.target.process.command_line = /\.bat/ nocase or $bat.target.process.command_line = /\.cmd/ nocase)

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(90)

  condition:
    $lnk and $bat
}

rule ahk_loader_hosts_file_modified {
  meta:
    author = "Detection Engineering"
    description = "Windows hosts file modified — used in the AHK loader campaign to sinkhole AV vendor domains to localhost and block cloud detection/updates."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Defense Evasion"
    mitre_attack_technique = "Impair Defenses: Disable or Modify Tools"
    mitre_attack_technique_id = "T1562.001"
    severity = "Medium"
    priority = "Medium"

  events:
    ($e.metadata.event_type = "FILE_MODIFICATION" or $e.metadata.event_type = "FILE_CREATION")
    $e.target.file.full_path = /drivers\\etc\\hosts$/ nocase
    not $e.principal.process.file.full_path = /\\(notepad|notepad\+\+|Code)\.exe$/ nocase

  outcome:
    $risk_score = max(55)

  condition:
    $e
}

rule ahk_loader_powershell_reflective_inmemory_load {
  meta:
    author = "Detection Engineering"
    description = "PowerShell reflectively loads a .NET assembly after a download cradle — consistent with the AHK loader's HCrypt-packed AsyncRAT stage (in-memory execution, no disk artifact)."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Defense Evasion"
    mitre_attack_technique = "Reflective Code Loading"
    mitre_attack_technique_id = "T1620"
    severity = "High"
    priority = "High"

  events:
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    (
      ($e.target.process.command_line = /\[Reflection\.Assembly\]/ nocase and $e.target.process.command_line = /Load/ nocase)
      or $e.target.process.command_line = /\[System\.Convert\]::FromBase64String/ nocase
      or $e.target.process.command_line = /IO\.MemoryStream/ nocase
      or $e.target.process.command_line = /Net\.WebClient/ nocase
    )

  outcome:
    $risk_score = max(75)

  condition:
    $e
}

rule ahk_loader_scriptblock_httpwebrequest_cradle {
  meta:
    author = "Detection Engineering"
    description = "PowerShell Script Block Logging (4104) captures an HttpWebRequest/GetResponseStream/IEX download cradle or a direct reference to stikked.ch — the deobfuscated form of the VBS dropper's StrReverse-built payload fetcher. VERIFY the UDM field path against your own 4104 ingestion before enabling (see header note)."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Execution"
    mitre_attack_technique = "Command and Scripting Interpreter: PowerShell"
    mitre_attack_technique_id = "T1059.001"
    severity = "Critical"
    priority = "Critical"

  events:
    $e.metadata.product_event_type = "4104"
    (
      ($e.target.process.command_line = /HttpWebRequest/ nocase and $e.target.process.command_line = /GetResponseStream/ nocase and $e.target.process.command_line = /IEX/ nocase)
      or $e.target.process.command_line = /stikked\.ch/ nocase
    )

  outcome:
    $risk_score = max(95)

  condition:
    $e
}

rule ahk_loader_multistage_chain_ahk_to_hidden_powershell {
  meta:
    author = "Detection Engineering"
    description = "Multi-event correlation: compiled AHK spawns a script host, which then spawns hidden/encoded PowerShell within 15 minutes on the same host — full initial-access chain of the AHK RAT loader campaign. Highest-confidence rule in this pack; this specific sequence has effectively no legitimate baseline."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Execution"
    mitre_attack_technique = "Command and Scripting Interpreter"
    mitre_attack_technique_id = "T1059"
    severity = "Critical"
    priority = "Critical"

  events:
    $e1.metadata.event_type = "PROCESS_LAUNCH"
    (
      $e1.principal.process.file.full_path = /AutoHotkey(U32|U64|A32)?\.exe$/ nocase
      or $e1.principal.process.command_line = /AutoHotkey/ nocase
    )
    $e1.target.process.file.full_path = /\\(wscript|cscript)\.exe$/ nocase
    $e1.target.process.pid = $pid
    $e1.principal.hostname = $hostname

    $e2.metadata.event_type = "PROCESS_LAUNCH"
    $e2.principal.process.pid = $pid
    $e2.principal.hostname = $hostname
    $e2.target.process.file.full_path = /\\(powershell|pwsh)\.exe$/ nocase
    $e2.target.process.command_line = /(-enc\b|-EncodedCommand|-e\b|-nop|-noni|-w(indowstyle)? ?hidden|IEX|Invoke-Expression|DownloadString|FromBase64String)/ nocase

  match:
    $hostname, $pid over 15m

  outcome:
    $risk_score = max(99)

  condition:
    $e1 and $e2
}

// ----------------------------------------------------------------------------
// Best-effort UDM approximation of the classic YARA content rule
// (AHK_Loader_VBS_StrReverse_Obfuscation). Only useful if your EDR/AMSI
// pipeline forwards raw script content into a UDM field. If it does not,
// disable this rule and rely on ahk_loader_vbs_obfuscation.yar instead.
// ----------------------------------------------------------------------------
rule ahk_loader_vbs_strreverse_obfuscation_udm_approx {
  meta:
    author = "Detection Engineering"
    description = "Approximates detection of VBS StrReverse()+Execute()+Chr(Asc(Mid())) obfuscation using a UDM field that carries raw script content, if your pipeline populates one (e.g. AMSI content logging forwarded to a script/command_line-like field). SPECULATIVE — confirm the field mapping in UDM Search before enabling."
    reference = "https://blog.morphisec.com/ahk-rat-loader-leveraged-in-unique-delivery-campaigns"
    mitre_attack_tactic = "Defense Evasion"
    mitre_attack_technique = "Obfuscated Files or Information"
    mitre_attack_technique_id = "T1027"
    severity = "Critical"
    priority = "Critical"

  events:
    $e.target.process.command_line = /Execute\(StrReverse\(/ nocase
    $e.target.process.command_line = /Chr\(Asc\(Mid\(/ nocase

  outcome:
    $risk_score = max(90)

  condition:
    $e
}
